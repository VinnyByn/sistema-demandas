rules_version = '2';

// Regras do Firebase Storage do sistema de demandas.
// Publicar com: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() ? string(request.auth.token.get('email', '')).lower() : '';
    }

    function marcado(v) {
      return v == true || v == 1 || (v is string && v.lower() in ['1', 'true']);
    }

    // Administrador ativo: mesma regra do firestore.rules (meta.roles, sem estar desabilitado nem removido).
    function isAdmin() {
      let email = userEmail();
      let m = firestore.get(/databases/(default)/documents/demandasSistema/meta).data;
      let papel = m.get('roles', {}).get(email, '');
      return email != ''
        && (email == 'vinicius.morais@soumaster.com.br'
            || (papel is string
                && papel.lower() in ['admin', 'administrador', 'administrator']
                && !marcado(m.get('disabledUsers', {}).get(email, false))
                && !marcado(m.get('purgedUsers', {}).get(email, false))));
    }

    // Backups automáticos: gravados só pelas Cloud Functions (Admin SDK); só administradores baixam.
    match /backups/{arquivo=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
