# ---- Supabase (Settings > API Keys). A chave secreta ignora as regras de acesso: nunca a coloque no site.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_


# Asana > Configurações > Apps > Token de acesso pessoal
ASANA_TOKEN=

BACKUP_CRON_SEGREDO=

# Firebase > Configurações > Contas de serviço > Gerar chave privada
GOOGLE_APPLICATION_CREDENTIALS=chave-do-firebase.json
