rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /*
     * Quem acessa o quê vem SÓ de demandasSistema/meta (o mesmo doc que o app e as funções usam):
     *   roles            e-mail → admin | projetista | visibilidade   (fora do mapa = sem acesso)
     *   disabledUsers    e-mail → true   (desabilitado: só lê)
     *   purgedUsers      e-mail → true   (removido: sem acesso)
     * O administrador principal (seed) sempre tem acesso total.
     * Mesma lógica de demandas-projetos/user-roles.js e functions/acesso.js — mudou aqui, mude lá.
     */

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() ? string(request.auth.token.get('email', '')).lower() : '';
    }

    function isSeedAdmin() {
      return userEmail() != '' && userEmail() == 'vinicius.morais@soumaster.com.br';
    }

    /* Valor "ligado" num mapa de marcação (o app grava true; aceita também 1, "1" e "true"). */
    function marcado(v) {
      return v == true || v == 1 || (v is string && v.lower() in ['1', 'true']);
    }

    /* Papel do usuário logado num doc meta (m = dados do doc). '' = fora do mapa. */
    function papelEm(m) {
      let p = m.get('roles', {}).get(userEmail(), '');
      return p is string ? p.lower() : '';
    }

    function mapeadoEm(m) {
      return userEmail() != ''
        && papelEm(m) != ''
        && !marcado(m.get('purgedUsers', {}).get(userEmail(), false));
    }

    function desabilitadoEm(m) {
      return marcado(m.get('disabledUsers', {}).get(userEmail(), false));
    }

    function temAcessoEm(m) {
      return isSeedAdmin() || mapeadoEm(m);
    }

    function podeEscreverEm(m) {
      return isSeedAdmin()
        || (mapeadoEm(m) && !desabilitadoEm(m)
            && !(papelEm(m) in ['visibilidade', 'leitura', 'readonly', 'viewer']));
    }

    function isAdminEm(m) {
      return isSeedAdmin()
        || (mapeadoEm(m) && !desabilitadoEm(m)
            && papelEm(m) in ['admin', 'administrador', 'administrator']);
    }

    /* Campos de acesso do meta: só administrador altera. */
    function chavesDeAcesso() {
      return ['roles', 'disabledUsers', 'purgedUsers', 'userRegionals', 'userDisplayNames', 'userHomes'];
    }

    function meta() {
      return get(/databases/$(database)/documents/demandasSistema/meta).data;
    }

    /* `||` curto-circuita: o seed admin não depende do doc meta existir. */
    function temAcesso() {
      return isSeedAdmin() || temAcessoEm(meta());
    }

    function podeEscrever() {
      return isSeedAdmin() || podeEscreverEm(meta());
    }

    function isAdmin() {
      return isSeedAdmin() || isAdminEm(meta());
    }

    match /demandas/{demandaId} {
      allow read: if temAcesso();
      allow create, update, delete: if podeEscrever();
    }

    match /demandasSistema/meta {
      allow read: if isSeedAdmin() || temAcessoEm(resource.data);
      /* Só o administrador principal cria o doc (ambiente novo). */
      allow create: if isSeedAdmin();
      /* Admin altera tudo; quem escreve altera diárias, projetistas, metas etc., nunca os acessos. */
      allow update: if isAdminEm(resource.data)
        || (podeEscreverEm(resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(chavesDeAcesso()));
      allow delete: if false;
    }

    /* Legado: só leitura para a migração manual (e a marca migratedAt). */
    match /demandasSistema/state {
      allow read: if temAcesso();
      allow write: if podeEscrever();
    }

    /* Situação do último backup automático: gravado só pelas Cloud Functions. */
    match /demandasSistema/backups {
      allow read: if temAcesso();
      allow write: if false;
    }

    /*
     * Histórico de mudanças de acesso (quem mudou o papel de quem, e quando).
     * Só administrador grava, sempre em nome próprio e com a hora do servidor; ninguém edita nem apaga.
     */
    match /acessosHistorico/{registroId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['em', 'por', 'alvo', 'acao', 'de', 'para'])
        && request.resource.data.keys().hasAll(['em', 'por', 'alvo', 'acao'])
        && request.resource.data.por == userEmail()
        && request.resource.data.em == request.time
        && request.resource.data.alvo is string && request.resource.data.alvo.size() <= 200
        && request.resource.data.acao is string && request.resource.data.acao.size() <= 40
        && (!('de' in request.resource.data) || (request.resource.data.de is string && request.resource.data.de.size() <= 200))
        && (!('para' in request.resource.data) || (request.resource.data.para is string && request.resource.data.para.size() <= 200));
      allow update, delete: if false;
    }

    /*
     * Antigo espelho de meta.roles. Ninguém mais lê; fica fechado para não virar uma segunda
     * fonte de verdade. (Versões antigas do app tentam gravar aqui e só registram um aviso.)
     */
    match /demandasSistema/roles {
      allow read, write: if false;
    }
  }
}
